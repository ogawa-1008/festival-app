# Xserver（Apache）用の設定。ビルドすると dist/ にコピーされる。
# このアプリは1枚のページ（index.html）の中で画面を切り替えるため、
# /q/QUEST_OSAKA_1（会場のQRコード）や /map などのURLを直接開いても index.html を返す。
# 実際にあるファイル（画像・JS など）と、API（/api/）はそのまま返す
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
