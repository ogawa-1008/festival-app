# Xserver（Apache）用の設定。ビルドすると dist/ にコピーされる。
# このアプリは1枚のページ（index.html）の中で画面を切り替えるため、
# /q/QUEST_OSAKA_1（会場のQRコード）や /map などのURLを直接開いても index.html を返す。
# 実際にあるファイル（画像・JS など）はそのまま返す。
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # API は廃止した（アクセス計測は Cloudflare）。/api/ は 404 を返す
  RewriteRule ^api/ - [L]

  # 存在しない画像・JS・CSS・フォントなどは 404 を返す。
  # index.html を返すと、Cloudflare がそのURLを画像としてキャッシュしてしまうため
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.(js|mjs|css|png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf|mp4|m4a|webmanifest)$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
